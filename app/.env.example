# ── Required ────────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
SESSION_SECRET=           # Long random string. Signs session cookies.
                          # Generate one: openssl rand -base64 32

# ── Email sign-in (one-time codes) ──────────────────────────────
RESEND_API_KEY=           # https://resend.com/api-keys  (starts with re_)
                          # If unset, the code is printed to the server console
                          # instead of being emailed - fine for local dev.
MAIL_FROM=                # e.g. "Toujours Belle <bonjour@toujours-belle.com>"
                          # Defaults to Resend's shared onboarding@resend.dev,
                          # which only delivers to your own Resend account email.

# ── Kimi OAuth (optional) ───────────────────────────────────────
# Leave all four blank to run with email sign-in only. Set all four to
# re-enable the "Sign in with Kimi" button.
APP_ID=                   # Kimi application ID
APP_SECRET=               # Kimi application secret
KIMI_AUTH_URL=            # Kimi OAuth server URL (e.g. https://auth.kimi.com)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login
