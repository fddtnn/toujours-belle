# ══ Sign-in (Supabase) ══════════════════════════════════════════
# This is what the live site uses. GitHub Pages serves static files only, so
# there is no server of ours to send a code or hold a session - Supabase does
# both from the browser.
#
# Put these in app/.env.local (git-ignored) and REBUILD: Vite bakes VITE_*
# values into the bundle at build time, so changing them needs a new build.
# Both are public by design; the database is protected by row-level security.
VITE_SUPABASE_URL=        # Project Settings → API → Project URL
VITE_SUPABASE_ANON_KEY=   # Project Settings → API → anon / public key
VITE_AUTH_GOOGLE=         # "on" once Google is enabled in Supabase →
                          # Authentication → Providers. Anything else hides
                          # the button, so it is never shown broken.

# ── Everything below belongs to the self-hosted Hono backend ────
# Only needed if you deploy app/api yourself instead of using Supabase.

# ── Required ────────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
SESSION_SECRET=           # Long random string. Signs session cookies.
                          # Generate one: openssl rand -base64 32

# ── Email sign-in (one-time codes) ──────────────────────────────
RESEND_API_KEY=           # https://resend.com/api-keys  (starts with re_)
                          # If unset, the code is printed to the server console
                          # instead of being emailed - fine for local dev.
MAIL_FROM=                # e.g. "Toujours Belle <bonjour@toujours-belle.com>"
                          # Defaults to Resend's shared onboarding@resend.dev,
                          # which only delivers to your own Resend account email.

# ── Kimi OAuth (optional) ───────────────────────────────────────
# Leave all four blank to run with email sign-in only. Set all four to
# re-enable the "Sign in with Kimi" button.
APP_ID=                   # Kimi application ID
APP_SECRET=               # Kimi application secret
KIMI_AUTH_URL=            # Kimi OAuth server URL (e.g. https://auth.kimi.com)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login
